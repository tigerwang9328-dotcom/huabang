<template>
  <div class="site" :class="{ 'menu-open': mobileMenu }">
    <!-- ===================== Header ===================== -->
    <header class="hdr" :class="{ solid: scrolled }">
      <div class="hdr-inner">
        <a href="#home" class="brand" @click.prevent="scrollTo('home')">
          <span class="brand-mark">WB</span>
          <span class="brand-text">
            <span class="brand-cn">华邦 <i>·</i> 莱勒</span>
            <span class="brand-en">WINBANG · LAILER</span>
          </span>
        </a>

        <nav class="nav" :class="{ open: mobileMenu }">
          <a
            v-for="s in sections"
            :key="s.id"
            :href="'#' + s.id"
            class="nav-link"
            :class="{ active: current === s.id }"
            @click.prevent="scrollTo(s.id)"
          >{{ s.label }}</a>
        </nav>

        <div class="hdr-right">
          <!-- 隐蔽员工入口 -->
          <button class="staff-entry" title="" aria-label="En" @click="goLogin">En</button>
          <button class="burger" :class="{ on: mobileMenu }" aria-label="菜单" @click="mobileMenu = !mobileMenu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- ===================== Hero ===================== -->
    <section id="home" class="hero">
      <div class="hero-slides">
        <div
          v-for="(img, i) in heroImgs"
          :key="i"
          class="hero-slide"
          :class="{ on: heroIdx === i }"
        >
          <img :src="img" alt="" class="hero-img" @error="imgFail" />
        </div>
        <div class="hero-veil"></div>
      </div>

      <div class="hero-content">
        <p class="hero-eyebrow reveal">EST. 2000 · 高端男装</p>
        <h1 class="hero-title">
          <span class="reveal" style="--d:.05s">始于 2000，二十载匠心</span>
          <span class="reveal gold" style="--d:.18s">定义现代男装美学</span>
        </h1>
        <p class="hero-sub reveal" style="--d:.32s">
          莱勒 LAILER · 以精工裁艺与现代审美，诠释当代男士的格调与从容
        </p>
        <div class="hero-actions reveal" style="--d:.46s">
          <button class="btn btn-gold" @click="scrollTo('products')">探索系列</button>
          <button class="btn btn-line" @click="scrollTo('about')">关于华邦</button>
        </div>
      </div>

      <div class="hero-dots">
        <button
          v-for="(img, i) in heroImgs"
          :key="i"
          class="dot"
          :class="{ on: heroIdx === i }"
          @click="heroIdx = i"
        ></button>
      </div>
      <div class="hero-scroll" @click="scrollTo('about')"><span></span>SCROLL</div>
    </section>

    <!-- ===================== About ===================== -->
    <section id="about" class="sec sec-about">
      <div class="wrap split">
        <div class="split-text reveal">
          <span class="kicker">关于华邦 · ABOUT</span>
          <h2 class="sec-title">二十载深耕，<br />从制造到零售的男装巨擘</h2>
          <p class="lead">
            华邦公司成立于 2000 年，深耕男装领域二十余载，从引领潮流的生产工厂，
            到成功运营 500 多家零售门店的行业巨擘，构建起工贸一体、设计制造与零售运营协同的完整体系。
          </p>
          <p class="para">
            我们坚持以品质为根、以审美为魂，将精工裁艺与现代设计融合，
            为每一位追求格调的男士打造从商务到生活的完整衣橱。
          </p>
          <div class="stats">
            <div class="stat"><b>20<i>+</i></b><span>年专注男装</span></div>
            <div class="stat"><b>500<i>+</i></b><span>家零售门店</span></div>
            <div class="stat"><b>7<i>+</i></b><span>代理品牌历程</span></div>
          </div>
        </div>
        <div class="split-media reveal" style="--d:.15s">
          <div class="media-frame">
            <img :src="aboutImg" alt="华邦总部" @error="imgFail" />
          </div>
          <div class="media-badge">WINBANG · since 2000</div>
        </div>
      </div>
    </section>

    <!-- ===================== Brand Heritage ===================== -->
    <section id="brand" class="sec sec-brand">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker light">品牌故事 · HERITAGE</span>
          <h2 class="sec-title light">主营品牌 · 莱勒 LAILER</h2>
        </div>

        <div class="brand-hero reveal" style="--d:.1s">
          <div class="brand-hero-media"><img :src="brandImg" alt="LAILER" @error="imgFail" /></div>
          <div class="brand-hero-text">
            <h3>LAILER<span>莱勒</span></h3>
            <p>
              莱勒以「精致而不张扬」为设计哲学，专注现代商务与轻奢休闲男装。
              每一件作品从面料甄选、版型剪裁到工艺细节，皆经反复打磨，
              只为呈现属于当代男士的高级质感与从容气度。
            </p>
            <ul class="brand-points">
              <li>意式精工剪裁</li>
              <li>高支精纺面料</li>
              <li>当代极简美学</li>
            </ul>
          </div>
        </div>

        <div class="partners reveal" style="--d:.2s">
          <p class="partners-title">雄厚实力 · 曾代理运营的辉煌品牌</p>
          <div class="partners-wall">
            <div class="partner" v-for="p in partners" :key="p">{{ p }}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== Products ===================== -->
    <section id="products" class="sec sec-products">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker">系列产品 · COLLECTIONS</span>
          <h2 class="sec-title">为不同场景，定义男士格调</h2>
        </div>
        <div class="prod-grid">
          <article
            v-for="(p, i) in products"
            :key="p.title"
            class="prod-card reveal"
            :style="{ '--d': 0.08 * i + 's' }"
          >
            <div class="prod-media">
              <img :src="p.img" :alt="p.title" @error="imgFail" />
              <div class="prod-overlay">
                <span class="prod-no">0{{ i + 1 }}</span>
              </div>
            </div>
            <div class="prod-info">
              <h3>{{ p.title }}<em>{{ p.en }}</em></h3>
              <p>{{ p.desc }}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================== Stores Gallery ===================== -->
    <section id="stores" class="sec sec-stores">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker light">门店形象 · BOUTIQUE</span>
          <h2 class="sec-title light">全国 500+ 豪华门店形象</h2>
        </div>
        <div class="gallery reveal" style="--d:.1s">
          <figure v-for="(g, i) in storeImgs" :key="i" :class="'g' + (i + 1)">
            <img :src="g.img" :alt="g.cap" @error="imgFail" />
            <figcaption>{{ g.cap }}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===================== Strength / Factory ===================== -->
    <section id="strength" class="sec sec-strength">
      <div class="wrap split split-rev">
        <div class="split-media reveal">
          <div class="media-frame dark"><img :src="factoryImg" alt="现代化工厂" @error="imgFail" /></div>
        </div>
        <div class="split-text reveal" style="--d:.15s">
          <span class="kicker">公司实力 · STRENGTH</span>
          <h2 class="sec-title">工贸一体，从一根纱线到一座衣橱</h2>
          <p class="lead">
            华邦拥有现代化生产基地与成熟供应链体系，集设计研发、生产制造与零售运营于一体。
            从面料到成衣，从工厂到门店，每一环节皆严控品质，以雄厚实力支撑品牌长期主义。
          </p>
          <div class="strength-list">
            <div class="sl-item"><b>现代化生产基地</b><span>规模化产能 · 精工流水线</span></div>
            <div class="sl-item"><b>成熟供应链</b><span>优质面料 · 稳定上新</span></div>
            <div class="sl-item"><b>全国零售网络</b><span>500+ 门店 · 标准化形象</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== Footer ===================== -->
    <footer class="ft">
      <div class="wrap ft-inner">
        <div class="ft-brand">
          <span class="brand-mark">WB</span>
          <div>
            <div class="ft-name">华邦公司 · 莱勒 LAILER</div>
            <div class="ft-slogan">始于 2000 · 高端男装 · 工贸一体</div>
          </div>
        </div>
        <div class="ft-cols">
          <div class="ft-col">
            <h4>联系我们</h4>
            <p>电话：400-000-0000</p>
            <p>邮箱：contact@winbang.example.com</p>
          </div>
          <div class="ft-col">
            <h4>公司地址</h4>
            <p>中国 · 总部地址（请在配置中替换）</p>
            <p>营业时间：9:00 - 21:00</p>
          </div>
          <div class="ft-col">
            <h4>导航</h4>
            <p><a href="#about" @click.prevent="scrollTo('about')">关于华邦</a></p>
            <p><a href="#products" @click.prevent="scrollTo('products')">系列产品</a></p>
            <p><a href="#stores" @click.prevent="scrollTo('stores')">门店形象</a></p>
          </div>
        </div>
      </div>
      <div class="ft-copy">© {{ year }} 华邦公司 WINBANG · 莱勒 LAILER · 版权所有</div>
    </footer>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted, nextTick } from "vue";
import { useRouter } from "vue-router";

const router = useRouter();
const year = new Date().getFullYear();

/* ---------- 导航 ---------- */
const sections = [
  { id: "home", label: "首页" },
  { id: "about", label: "关于华邦" },
  { id: "brand", label: "品牌故事" },
  { id: "products", label: "系列产品" },
  { id: "stores", label: "门店形象" },
  { id: "strength", label: "公司实力" },
];
const current = ref("home");
const scrolled = ref(false);
const mobileMenu = ref(false);

const scrollTo = (id: string) => {
  mobileMenu.value = false;
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
};

/* ---------- 图片（Unsplash，失败渐变兜底） ---------- */
const U = (id: string, w = 1600) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&q=80`;

const heroImgs = [U("1507003211169-0a1dd7228f2d"), U("1488161628813-04466f872be2"), U("1521572163474-6864f9cf17ab")];
const aboutImg = U("1497366216548-37526070297c", 1100);
const brandImg = U("1594938298603-c8148c4dae35", 1100);
const factoryImg = U("1581091226825-a6a2a5aee158", 1100);

const products = [
  { title: "商务正装", en: "Business", desc: "精工西装与衬衫，演绎职场的精致与权威。", img: U("1593030761757-71fae45fa0e7", 800) },
  { title: "轻奢休闲", en: "Smart Casual", desc: "高级面料与利落版型，从容应对每一种生活场景。", img: U("1490578474895-699cd4e2cf59", 800) },
  { title: "高定系列", en: "Couture", desc: "限量高定工艺，为讲究之人量身定义格调。", img: U("1521577352947-9bb58764b69a", 800) },
];

const storeImgs = [
  { cap: "城市旗舰店", img: U("1441986300917-64674bd600d8", 900) },
  { cap: "购物中心精品店", img: U("1483985988355-763728e1935b", 900) },
  { cap: "门店陈列空间", img: U("1567401893414-76b7b1e5a7a5", 900) },
  { cap: "商圈形象店", img: U("1555529669-e69e7aa0ba9a", 900) },
];

const partners = ["路卡迪龙", "迪柯尼", "佛伦蒂尼", "伦敦保罗", "凯迪东尼", "威利", "迪赛"];

const imgFail = (e: Event) => {
  (e.target as HTMLImageElement).style.opacity = "0";
};

/* ---------- Hero 轮播 ---------- */
const heroIdx = ref(0);
let heroTimer: number | undefined;
const startHero = () => {
  heroTimer = window.setInterval(() => {
    heroIdx.value = (heroIdx.value + 1) % heroImgs.length;
  }, 5000);
};

/* ---------- 滚动监听 + Intersection Observer ---------- */
const onScroll = () => { scrolled.value = window.scrollY > 40; };
let io: IntersectionObserver | undefined;
let spy: IntersectionObserver | undefined;

onMounted(async () => {
  window.addEventListener("scroll", onScroll, { passive: true });
  startHero();
  await nextTick();

  // 进入视口淡入
  io = new IntersectionObserver(
    (entries) => entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io!.unobserve(en.target); } }),
    { threshold: 0.12 }
  );
  document.querySelectorAll(".reveal").forEach((el) => io!.observe(el));

  // 导航高亮当前板块
  spy = new IntersectionObserver(
    (entries) => entries.forEach((en) => { if (en.isIntersecting) current.value = en.target.id; }),
    { rootMargin: "-45% 0px -50% 0px" }
  );
  sections.forEach((s) => { const el = document.getElementById(s.id); if (el) spy!.observe(el); });
});

onUnmounted(() => {
  window.removeEventListener("scroll", onScroll);
  if (heroTimer) clearInterval(heroTimer);
  io?.disconnect();
  spy?.disconnect();
});

const goLogin = () => {
  router.push("/login");
};
</script>

<style scoped>
/* ===== 基础 ===== */
.site { --bg:#0b0b0d; --ink:#14141a; --paper:#f6f3ee; --gold:#c9a55c; --gold-2:#e6c884; --ember:#d6603a; --muted:#9a9aa3;
  background: var(--bg); color: #efeee9; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  overflow-x: hidden; }
.wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 28px; }
img { display: block; width: 100%; height: 100%; object-fit: cover; }
.kicker { display:inline-block; font-size:12px; letter-spacing:.34em; color:var(--gold); font-weight:600; margin-bottom:18px; text-transform:uppercase; }
.kicker.light { color: var(--gold-2); }
.sec-title { font-size: clamp(26px, 3.6vw, 42px); font-weight: 800; line-height: 1.18; color: #1b1b20; letter-spacing: .01em; }
.sec-title.light { color: #fff; }
.btn { display:inline-flex; align-items:center; justify-content:center; height:48px; padding:0 30px; border-radius:30px;
  font-size:14.5px; font-weight:700; letter-spacing:.08em; cursor:pointer; border:none; transition:.2s; }
.btn-gold { background: linear-gradient(135deg, var(--gold-2), var(--gold)); color:#241a07; }
.btn-gold:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(201,165,92,.35); }
.btn-line { background: transparent; color:#fff; border:1.5px solid rgba(255,255,255,.35); }
.btn-line:hover { background: rgba(255,255,255,.1); border-color:#fff; }

/* ===== 揭示动画 ===== */
.reveal { opacity:0; transform: translateY(36px); transition: opacity .9s cubic-bezier(.2,.7,.2,1) var(--d,0s), transform .9s cubic-bezier(.2,.7,.2,1) var(--d,0s); }
.reveal.in { opacity:1; transform:none; }

/* ===== Header ===== */
.hdr { position: fixed; top:0; left:0; right:0; z-index:50; transition: background .3s, box-shadow .3s, backdrop-filter .3s; }
.hdr.solid { background: rgba(11,11,13,.82); backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgba(255,255,255,.06); }
.hdr-inner { max-width:1240px; margin:0 auto; padding: 0 28px; height:74px; display:flex; align-items:center; justify-content:space-between; }
.brand { display:flex; align-items:center; gap:12px; text-decoration:none; }
.brand-mark { width:40px; height:40px; flex-shrink:0; border-radius:9px; display:flex; align-items:center; justify-content:center;
  font-weight:900; font-size:15px; color:#241a07; letter-spacing:.5px; background: linear-gradient(135deg, var(--gold-2), var(--gold)); }
.brand-text { display:flex; flex-direction:column; line-height:1.15; }
.brand-cn { font-size:16px; font-weight:800; color:#fff; letter-spacing:.04em; }
.brand-cn i { color: var(--gold); font-style:normal; margin:0 2px; }
.brand-en { font-size:9.5px; letter-spacing:.26em; color: rgba(255,255,255,.45); }
.nav { display:flex; align-items:center; gap:34px; }
.nav-link { position:relative; color: rgba(255,255,255,.72); font-size:14px; font-weight:500; text-decoration:none; padding:6px 0; transition:color .2s; }
.nav-link:hover { color:#fff; }
.nav-link.active { color: var(--gold-2); }
.nav-link::after { content:""; position:absolute; left:0; bottom:0; height:1.5px; width:0; background: var(--gold); transition: width .25s; }
.nav-link:hover::after, .nav-link.active::after { width:100%; }
.hdr-right { display:flex; align-items:center; gap:14px; }
/* 隐蔽入口 */
.staff-entry { background:none; border:1px solid rgba(255,255,255,.16); color: rgba(255,255,255,.32);
  font-size:12px; letter-spacing:.18em; padding:5px 11px; border-radius:14px; cursor:pointer; transition: .25s; }
.staff-entry:hover { color: var(--gold-2); border-color: rgba(201,165,92,.6); opacity:1; }
.burger { display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:6px; }
.burger span { width:24px; height:2px; background:#fff; border-radius:2px; transition:.25s; }
.burger.on span:nth-child(1){ transform: translateY(7px) rotate(45deg); }
.burger.on span:nth-child(2){ opacity:0; }
.burger.on span:nth-child(3){ transform: translateY(-7px) rotate(-45deg); }

/* ===== Hero ===== */
.hero { position:relative; height:100vh; min-height:620px; display:flex; align-items:center; overflow:hidden; }
.hero-slides { position:absolute; inset:0; background: linear-gradient(135deg, #1a1a22, #0b0b0d); }
.hero-slide { position:absolute; inset:0; opacity:0; transition: opacity 1.4s ease, transform 7s ease; transform: scale(1.08); }
.hero-slide.on { opacity:1; transform: scale(1); }
.hero-img { filter: contrast(1.02) saturate(1.02); }
.hero-veil { position:absolute; inset:0; background:
  linear-gradient(90deg, rgba(8,8,10,.86) 0%, rgba(8,8,10,.5) 42%, rgba(8,8,10,.2) 100%),
  linear-gradient(0deg, rgba(8,8,10,.75), transparent 45%); }
.hero-content { position:relative; z-index:2; max-width:1240px; margin:0 auto; padding:0 28px; width:100%; }
.hero-eyebrow { font-size:13px; letter-spacing:.42em; color: var(--gold-2); font-weight:600; margin-bottom:22px; }
.hero-title { font-size: clamp(34px, 6.6vw, 78px); font-weight:900; line-height:1.08; letter-spacing:.01em; }
.hero-title span { display:block; }
.hero-title .gold { background: linear-gradient(100deg, var(--gold-2), var(--gold), #fff 130%); -webkit-background-clip:text; background-clip:text; color: transparent; }
.hero-sub { margin-top:24px; font-size: clamp(14px, 1.8vw, 18px); color: rgba(255,255,255,.78); max-width:560px; line-height:1.85; }
.hero-actions { margin-top:38px; display:flex; gap:16px; flex-wrap:wrap; }
.hero-dots { position:absolute; bottom:42px; left:50%; transform:translateX(-50%); z-index:3; display:flex; gap:10px; }
.dot { width:26px; height:3px; border-radius:3px; border:none; background: rgba(255,255,255,.3); cursor:pointer; transition:.3s; }
.dot.on { background: var(--gold-2); width:40px; }
.hero-scroll { position:absolute; right:34px; bottom:38px; z-index:3; color: rgba(255,255,255,.55); font-size:10px; letter-spacing:.3em;
  display:flex; align-items:center; gap:10px; cursor:pointer; }
.hero-scroll span { width:1px; height:46px; background: linear-gradient(var(--gold-2), transparent); display:block; }
@media (max-width:760px){ .hero-scroll{ display:none; } }

/* ===== Section 通用 ===== */
.sec { padding: clamp(70px, 9vw, 130px) 0; }
.sec-head { text-align:center; max-width:720px; margin:0 auto clamp(40px,5vw,64px); }
.split { display:grid; grid-template-columns: 1.05fr .95fr; gap: clamp(36px, 5vw, 76px); align-items:center; }
.split-text .lead { margin-top:22px; font-size:16px; line-height:1.95; color:#3a3a42; }
.split-text .para { margin-top:16px; font-size:14.5px; line-height:1.9; color:#5d5d66; }

/* About */
.sec-about { background: var(--paper); color:#1b1b20; }
.stats { display:flex; gap:38px; margin-top:40px; flex-wrap:wrap; }
.stat b { font-size: clamp(30px,4vw,44px); font-weight:900; color:#1b1b20; display:block; line-height:1; }
.stat b i { color: var(--gold); font-style:normal; font-size:.6em; }
.stat span { font-size:13px; color:#8a8a93; margin-top:8px; display:block; letter-spacing:.04em; }
.split-media { position:relative; }
.media-frame { border-radius:18px; overflow:hidden; aspect-ratio: 4/5; background: linear-gradient(135deg,#23232c,#3a3a47); box-shadow: 0 30px 70px rgba(0,0,0,.22); }
.media-frame.dark { aspect-ratio: 5/4; }
.media-badge { position:absolute; left:-14px; bottom:26px; background: linear-gradient(135deg, var(--gold-2), var(--gold)); color:#241a07;
  font-size:12px; font-weight:800; letter-spacing:.12em; padding:10px 18px; border-radius:10px; box-shadow:0 14px 30px rgba(201,165,92,.4); }

/* Brand */
.sec-brand { background: linear-gradient(180deg, #0e0e12, #16161d); }
.brand-hero { display:grid; grid-template-columns: 1fr 1fr; gap: clamp(28px,4vw,60px); align-items:center; margin-bottom: clamp(48px,6vw,80px); }
.brand-hero-media { border-radius:18px; overflow:hidden; aspect-ratio: 1/1; background: linear-gradient(135deg,#22222b,#3a3a47); box-shadow:0 30px 70px rgba(0,0,0,.4); }
.brand-hero-text h3 { font-size: clamp(34px,5vw,58px); font-weight:900; color:#fff; letter-spacing:.04em; display:flex; align-items:baseline; gap:14px; }
.brand-hero-text h3 span { font-size:.36em; letter-spacing:.3em; color: var(--gold-2); font-weight:600; }
.brand-hero-text p { margin-top:20px; font-size:15px; line-height:1.95; color: rgba(255,255,255,.72); }
.brand-points { display:flex; gap:12px; margin-top:26px; flex-wrap:wrap; list-style:none; }
.brand-points li { border:1px solid rgba(201,165,92,.4); color: var(--gold-2); font-size:13px; padding:8px 16px; border-radius:30px; }
.partners-title { text-align:center; color: rgba(255,255,255,.55); font-size:13px; letter-spacing:.18em; margin-bottom:26px; }
.partners-wall { display:flex; flex-wrap:wrap; justify-content:center; gap:14px; }
.partner { padding:16px 26px; border:1px solid rgba(255,255,255,.12); border-radius:12px; color: rgba(255,255,255,.85);
  font-size:16px; font-weight:700; letter-spacing:.06em; background: rgba(255,255,255,.02); transition:.25s; }
.partner:hover { border-color: var(--gold); color: var(--gold-2); transform: translateY(-3px); background: rgba(201,165,92,.06); }

/* Products */
.sec-products { background: var(--paper); color:#1b1b20; }
.prod-grid { display:grid; grid-template-columns: repeat(3,1fr); gap:26px; }
.prod-card { background:#fff; border-radius:16px; overflow:hidden; box-shadow: 0 14px 40px rgba(20,20,30,.08); }
.prod-media { position:relative; aspect-ratio: 3/4; overflow:hidden; background: linear-gradient(135deg,#23232c,#3a3a47); }
.prod-media img { transition: transform .8s cubic-bezier(.2,.7,.2,1); }
.prod-card:hover .prod-media img { transform: scale(1.09); }
.prod-overlay { position:absolute; inset:0; background: linear-gradient(0deg, rgba(10,10,12,.5), transparent 50%); }
.prod-no { position:absolute; top:16px; left:18px; color:#fff; font-size:13px; font-weight:800; letter-spacing:.1em; opacity:.85; }
.prod-info { padding:22px 22px 26px; }
.prod-info h3 { font-size:20px; font-weight:800; color:#1b1b20; display:flex; align-items:baseline; gap:10px; }
.prod-info h3 em { font-style:normal; font-size:12px; letter-spacing:.16em; color: var(--gold); font-weight:600; }
.prod-info p { margin-top:10px; font-size:13.5px; line-height:1.75; color:#6b6b73; }

/* Stores Gallery */
.sec-stores { background: linear-gradient(180deg, #16161d, #0e0e12); }
.gallery { display:grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 200px; gap:18px; }
.gallery figure { position:relative; margin:0; border-radius:14px; overflow:hidden; background: linear-gradient(135deg,#22222b,#3a3a47); }
.gallery figure img { transition: transform .8s ease; }
.gallery figure:hover img { transform: scale(1.08); }
.gallery figcaption { position:absolute; left:0; right:0; bottom:0; padding:14px 16px; font-size:13px; font-weight:600; color:#fff;
  background: linear-gradient(0deg, rgba(8,8,10,.8), transparent); letter-spacing:.04em; }
.gallery .g1 { grid-column: span 2; grid-row: span 2; }
.gallery .g4 { grid-column: span 2; }

/* Strength */
.sec-strength { background: var(--paper); color:#1b1b20; }
.split-rev .split-media { order:0; }
.strength-list { margin-top:30px; display:flex; flex-direction:column; gap:14px; }
.sl-item { display:flex; flex-direction:column; padding:16px 20px; background:#fff; border-radius:12px; border-left:3px solid var(--gold); box-shadow:0 8px 24px rgba(20,20,30,.05); }
.sl-item b { font-size:16px; color:#1b1b20; }
.sl-item span { font-size:13px; color:#8a8a93; margin-top:5px; }

/* Footer */
.ft { background:#08080a; padding-top: 64px; }
.ft-inner { display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap; padding-bottom:44px; }
.ft-brand { display:flex; gap:14px; align-items:center; }
.ft-name { font-size:16px; font-weight:800; color:#fff; }
.ft-slogan { font-size:12.5px; color: rgba(255,255,255,.45); margin-top:6px; letter-spacing:.04em; }
.ft-cols { display:flex; gap:60px; flex-wrap:wrap; }
.ft-col h4 { font-size:13px; color: var(--gold-2); letter-spacing:.1em; margin-bottom:14px; font-weight:700; }
.ft-col p { font-size:13.5px; color: rgba(255,255,255,.6); line-height:2; }
.ft-col a { color: rgba(255,255,255,.6); text-decoration:none; }
.ft-col a:hover { color: var(--gold-2); }
.ft-copy { border-top:1px solid rgba(255,255,255,.07); text-align:center; padding:20px; font-size:12px; color: rgba(255,255,255,.35); }

/* ===== Modal ===== */
.modal-mask { position:fixed; inset:0; z-index:100; display:flex; align-items:center; justify-content:center; padding:24px;
  background: rgba(8,8,12,.55); backdrop-filter: blur(10px); }
.modal-card { position:relative; width:100%; max-width:400px; padding:42px 36px 32px; border-radius:20px;
  background: linear-gradient(165deg, rgba(28,28,36,.96), rgba(16,16,22,.98)); border:1px solid rgba(201,165,92,.22);
  box-shadow: 0 40px 100px rgba(0,0,0,.6); text-align:center; }
.modal-x { position:absolute; top:16px; right:18px; background:none; border:none; color: rgba(255,255,255,.4); font-size:16px; cursor:pointer; }
.modal-x:hover { color:#fff; }
.modal-logo { display:flex; justify-content:center; margin-bottom:16px; }
.modal-logo .brand-mark { width:52px; height:52px; font-size:18px; border-radius:13px; }
.modal-title { font-size:21px; font-weight:800; color:#fff; }
.modal-sub { font-size:12.5px; color: rgba(255,255,255,.5); margin-top:8px; letter-spacing:.06em; }
.modal-form { margin-top:26px; text-align:left; display:flex; flex-direction:column; gap:16px; }
.field span { display:block; font-size:12.5px; color: rgba(255,255,255,.6); margin-bottom:8px; letter-spacing:.04em; }
.field input { width:100%; height:46px; padding:0 16px; border-radius:11px; background: rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.14); color:#fff; font-size:14.5px; outline:none; transition:.2s; }
.field input::placeholder { color: rgba(255,255,255,.3); }
.field input:focus { border-color: var(--gold); background: rgba(201,165,92,.08); }
.modal-submit { width:100%; margin-top:6px; height:50px; }
.modal-submit:disabled { opacity:.6; cursor:not-allowed; }
.modal-foot { margin-top:20px; }
.modal-link { font-size:12.5px; color: rgba(255,255,255,.45); text-decoration:none; letter-spacing:.04em; }
.modal-link:hover { color: var(--gold-2); }
.modal-enter-active, .modal-leave-active { transition: opacity .3s; }
.modal-enter-from, .modal-leave-to { opacity:0; }
.modal-enter-active .modal-card { transition: transform .35s cubic-bezier(.2,.8,.2,1); }
.modal-enter-from .modal-card { transform: translateY(24px) scale(.96); }

/* ===== 响应式 ===== */
@media (max-width: 980px) {
  .prod-grid { grid-template-columns: repeat(2,1fr); }
  .gallery { grid-template-columns: repeat(2,1fr); grid-auto-rows: 180px; }
  .gallery .g1 { grid-column: span 2; grid-row: span 1; }
  .gallery .g4 { grid-column: span 2; }
}
@media (max-width: 820px) {
  .nav { position:fixed; inset:74px 0 auto 0; flex-direction:column; align-items:stretch; gap:0;
    background: rgba(11,11,13,.97); backdrop-filter: blur(16px); padding:8px 28px 22px; transform: translateY(-130%);
    transition: transform .35s cubic-bezier(.2,.8,.2,1); border-bottom:1px solid rgba(255,255,255,.08); }
  .nav.open { transform: translateY(0); }
  .nav-link { padding:14px 0; border-bottom:1px solid rgba(255,255,255,.06); font-size:15px; }
  .nav-link::after { display:none; }
  .burger { display:flex; }
  .split { grid-template-columns: 1fr; }
  .split-rev .split-media { order:2; }
  .brand-hero { grid-template-columns: 1fr; }
  .stats { gap:26px; }
}
@media (max-width: 560px) {
  .prod-grid { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: 1fr; grid-auto-rows: 200px; }
  .gallery .g1, .gallery .g4 { grid-column: span 1; grid-row: span 1; }
  .ft-cols { gap:32px; }
  .brand-en { display:none; }
}
</style>
