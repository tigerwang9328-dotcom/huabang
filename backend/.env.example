# ============================================================
# 华邦AI中台 环境变量配置模板
# 复制本文件为 .env 并填入真实值
# 警告：.env 绝不提交到 Git，此文件不含任何真实密钥
# ============================================================

APP_ENV=production
APP_SECRET_KEY=请替换为openssl rand -hex 32生成的随机字符串
APP_DEBUG=false
ALLOWED_ORIGINS=http://100.94.89.49,http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=huabang_ai
DB_USER=huabang
DB_PASSWORD=请替换为强密码

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET_KEY=请替换为openssl rand -hex 64生成的随机字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DASHSCOPE_API_KEY=请填入阿里云百炼API_KEY
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=请填入DeepSeek_API_KEY
DEEPSEEK_MODEL=deepseek-v4-pro
AI_BUSINESS_ADVICE_ENABLED=false
AI_BUSINESS_ADVICE_MODEL=deepseek-v4-pro
AI_BUSINESS_ADVICE_CONCURRENCY=3
AI_BUSINESS_ADVICE_TIMEOUT_SECONDS=60
AI_BUSINESS_ADVICE_BATCH_TIME=06:45
AI_BUSINESS_ADVICE_REFRESH_WINDOW_SECONDS=600
DEEPSEEK_BASE_URL=https://api.deepseek.com

AI_PROVIDER=deepseek

DINGTALK_APP_ID=请填入钉钉企业应用APP_ID
DINGTALK_AGENT_ID=请填入钉钉AgentId
DINGTALK_CLIENT_ID=请填入钉钉ClientId
DINGTALK_CLIENT_SECRET=请填入钉钉ClientSecret
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_TEST_WEBHOOK=请填入测试群机器人Webhook
DINGTALK_TEST_MODE=true
DINGTALK_PUSH_ENABLED=false
DINGTALK_MAX_PUSH_PER_HOUR=1

BAISON_API_URL=
BAISON_API_KEY=
BAISON_API_ENABLED=false

KINGDEE_API_URL=
KINGDEE_API_KEY=
KINGDEE_API_ENABLED=false

UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=xlsx,xls,csv

LOG_LEVEL=INFO
LOG_FORMAT=json

# 百胜 E3ERP 开放平台（API 联调）
BAISON_API_BASE_URL=
BAISON_APP_KEY=
BAISON_APP_SECRET=
BAISON_SIGN_METHOD=md5
BAISON_PAGE_SIZE=20
BAISON_HTTP_METHOD=POST
BAISON_API_VERSION=2.0
BAISON_FORMAT=json

LIFE_DATA_COLLECTOR_TOKEN_SHA256=
LIFE_DATA_ACCOUNT_ID=1798826701211732
LIFE_DATA_TASK_CREATOR_ID=1
