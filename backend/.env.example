# ============================================================
# 华邦AI中台 环境变量配置模板
# 复制本文件为 .env 并填入真实值，.env 不提交到 Git
# ============================================================

# 应用配置
APP_ENV=development
APP_SECRET_KEY=请替换为随机生成的32位以上字符串
APP_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://100.94.89.49

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=huabang_ai
DB_USER=huabang
DB_PASSWORD=请替换为强密码

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=请替换为随机生成的64位以上字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 阿里云百炼 (通义千问)
DASHSCOPE_API_KEY=请填入阿里云百炼API_KEY
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=请填入DeepSeek_API_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认使用哪个AI提供商: dashscope | deepseek | openai
AI_PROVIDER=dashscope

# 钉钉配置 (华邦钉钉机器人)
DINGTALK_APP_ID=DINGTALK_APP_ID_PLACEHOLDER
DINGTALK_AGENT_ID=DINGTALK_AGENT_ID_PLACEHOLDER
DINGTALK_CLIENT_ID=DINGTALK_CLIENT_ID_PLACEHOLDER
DINGTALK_CLIENT_SECRET=DINGTALK_SECRET_PLACEHOLDER
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_PUSH_ENABLED=false
DINGTALK_MAX_PUSH_PER_HOUR=1

# 百盛ERP (第一阶段先用Excel导入)
BAISON_API_URL=
BAISON_API_KEY=
BAISON_API_ENABLED=false

# 金蝶财务 (第一阶段先用手工补录)
KINGDEE_API_URL=
KINGDEE_API_KEY=
KINGDEE_API_ENABLED=false

# 文件上传
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=xlsx,xls,csv

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json
